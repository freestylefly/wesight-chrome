{
  "extends": "plasmo/templates/tsconfig.base",
  "include": [
    ".plasmo/index.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "build"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~*": [
        "./*"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["chrome", "node", "vitest/globals"]
  }
}
